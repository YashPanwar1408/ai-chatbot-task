# Application
APP_NAME=shorts-reels-rag-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
CORS_ORIGINS=["http://localhost:3000"]

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shorts_reels_rag

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=run
# Set true to skip Redis (in-memory SSE + chat memory). Auto-fallback if Redis is down.
REDIS_USE_MEMORY=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=content_chunks_bge_large_v1_5
QDRANT_VECTOR_SIZE=1024
# Set true to skip Qdrant (in-memory vectors). Auto-fallback if Qdrant is down.
QDRANT_USE_MEMORY=false

# Embeddings (BGE)
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL_NAME=bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LangGraph
LANGGRAPH_CHECKPOINT_BACKEND=redis
GRAPH_VERSION=1.0.0

# Auth (configure per deployment)
DEV_AUTH_BYPASS=true
DEFAULT_ORG_NAME=Default Organization
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# External APIs
YOUTUBE_API_KEY=
# Optional. Instagram User access token from Meta Developer (see README).
# Only returns view counts for Reels owned by the connected account — not arbitrary public URLs.
INSTAGRAM_ACCESS_TOKEN=
# Optional. Netscape cookies.txt exported while logged into instagram.com (helps yt-dlp).
INSTAGRAM_COOKIES_FILE=

# Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# RAG
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.35
GRADE_MIN_CHUNKS=2
CHAT_MEMORY_TTL_SECONDS=86400
CHAT_MEMORY_MAX_MESSAGES=40

# Observability
LOG_LEVEL=INFO
OTEL_ENABLED=false
