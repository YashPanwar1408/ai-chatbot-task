# =============================================================================
# Shorts × Reels RAG Platform — Environment Variables
# Copy to backend/.env and frontend/.env.local as appropriate
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (FastAPI) — place in backend/.env
# -----------------------------------------------------------------------------

# Application
APP_NAME=shorts-reels-rag-api
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
CORS_ORIGINS=["http://localhost:3000"]

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (async SQLAlchemy + Alembic sync URL derived automatically)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shorts_reels_rag

# Redis — DB 0: streams + chat memory; DB 1/2: Celery (configured, workers stubbed)
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=run

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=content_chunks_bge_large_v1_5
QDRANT_VECTOR_SIZE=1024

# Embeddings — model loaded in-process via sentence-transformers (EMBEDDING_SERVICE_URL unused today)
EMBEDDING_SERVICE_URL=http://localhost:8081
EMBEDDING_MODEL_NAME=bge-large-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Google Gemini (required for grade + generate + query rewrite)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LangGraph
LANGGRAPH_CHECKPOINT_BACKEND=redis
GRAPH_VERSION=1.0.0

# Auth — production must set DEV_AUTH_BYPASS=false and implement JWT
DEV_AUTH_BYPASS=true
DEFAULT_ORG_NAME=Default Organization
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# External APIs (optional; extraction primarily uses yt-dlp)
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=

# Celery (scaffolded workers — not wired to ingest/chat yet)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# RAG tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_SCORE_THRESHOLD=0.35
GRADE_MIN_CHUNKS=2
CHAT_MEMORY_TTL_SECONDS=86400
CHAT_MEMORY_MAX_MESSAGES=40

# Observability
LOG_LEVEL=INFO
OTEL_ENABLED=false

# -----------------------------------------------------------------------------
# Frontend (Next.js) — place in frontend/.env.local
# -----------------------------------------------------------------------------

API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
